# FastAPI: GetStream credentials. The API key is public; the secret is server-only.
STREAM_API_KEY=
STREAM_API_SECRET=
STREAM_TOKEN_TTL_SECONDS=3600

# FastAPI: PostgreSQL. These are safe example-only local credentials.
DATABASE_URL=postgresql+psycopg://roomtone:roomtone@localhost:5432/roomtone

# FastAPI: application and session behavior.
APP_ENVIRONMENT=development
WEB_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=roomtone_session
SESSION_TTL_DAYS=7
HOST_LEASE_TTL_SECONDS=20
COOKIE_SECURE=false

# Next.js server: private/local FastAPI origin used by the same-origin /api proxy.
# Do not prefix this with NEXT_PUBLIC_; browser code should call relative /api paths.
BACKEND_ORIGIN=http://localhost:8000

# Next.js: public URL used when constructing share links.
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
